# =============================================================================
# Aashray'sPA — Environment Configuration
# =============================================================================
# Copy this file to `.env` and fill in the values for your environment.
#   cp .env.example .env
# NEVER commit the actual .env file to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
# Display name of the application
APP_NAME=AashraysPA
# Semantic version of the application
APP_VERSION=0.1.0
# Environment: development | staging | production
APP_ENV=development
# Enable debug mode (true in dev, false in production)
DEBUG=true
# Application-wide secret key — CHANGE THIS in production
SECRET_KEY=your-secret-key-change-in-production

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# PostgreSQL connection string (recommended for production)
DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/aashrays_pa
# For local development without PostgreSQL, uncomment the line below:
# DATABASE_URL=sqlite:///./aashrays_pa.db

# -----------------------------------------------------------------------------
# AI Provider
# -----------------------------------------------------------------------------
# Google Gemini API key — obtain from https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key
# AI provider to use (currently only "gemini" is supported)
AI_PROVIDER=gemini
# Model identifier for the AI provider
AI_MODEL=gemini-2.0-flash

# -----------------------------------------------------------------------------
# Security — JWT & Encryption
# -----------------------------------------------------------------------------
# Secret key for signing JWT tokens — CHANGE THIS in production
JWT_SECRET_KEY=your-jwt-secret-change-in-production
# Algorithm used for JWT encoding
JWT_ALGORITHM=HS256
# Token expiration time in minutes (1440 = 24 hours)
JWT_EXPIRATION_MINUTES=1440
# Fernet symmetric encryption key for encrypting sensitive data at rest
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your-fernet-key-generate-with-cryptography

# -----------------------------------------------------------------------------
# CORS — Cross-Origin Resource Sharing
# -----------------------------------------------------------------------------
# Allowed origins as a JSON array (Next.js frontend default port)
CORS_ORIGINS=["http://localhost:3000"]

# -----------------------------------------------------------------------------
# WhatsApp Cloud API
# -----------------------------------------------------------------------------
# Meta Graph API version for WhatsApp
WHATSAPP_API_VERSION=v21.0
# Verification token you define — used to verify webhook subscription
WHATSAPP_VERIFY_TOKEN=your-webhook-verify-token
# Phone Number ID from Meta Business Suite
WHATSAPP_BUSINESS_PHONE_ID=
# Permanent access token for WhatsApp Business API
WHATSAPP_BUSINESS_ACCESS_TOKEN=

# -----------------------------------------------------------------------------
# Instagram API
# -----------------------------------------------------------------------------
# Verification token you define — used to verify webhook subscription
INSTAGRAM_VERIFY_TOKEN=your-webhook-verify-token
# Instagram App ID from Meta Developer Portal
INSTAGRAM_APP_ID=
# Instagram App Secret from Meta Developer Portal
INSTAGRAM_APP_SECRET=
# Long-lived access token for Instagram Graph API
INSTAGRAM_ACCESS_TOKEN=

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
# Log level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
